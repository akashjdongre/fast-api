# .dockerignore

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/

# Virtual environments
venv/
env/
.venv/

# Environment files — never bake secrets into image
.env
.env.prod
.env.local

# Development files
.git/
.github/
.pytest_cache/
htmlcov/
test.db
*.coverage

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db